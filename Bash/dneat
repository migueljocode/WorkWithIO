#!/usr/bin/env bash
# dneat (Linux) – smart batch downloader: resumable, multi-connection transfers powered by aria2.
# URLs come from the clipboard, the command line or list files; unfinished downloads are saved for resuming.
# Missing prerequisites (aria2, a clipboard helper) are installed with your package manager only when needed.

set -euo pipefail
(( BASH_VERSINFO[0] > 4 || BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 4 )) || { echo "dneat needs bash 4.4 or newer." >&2; exit 1; }

readonly VERSION="1.1.0"
readonly DEFAULT_JOBS=1
readonly DEFAULT_CONNECTIONS=16
readonly DEFAULT_SESSION="resume.session"
readonly URL_RE='((https?|ftps?|sftp)://|magnet:\?)[^[:space:]]+'   # what is picked out of clipboard text
readonly TICK_US=500000                                   # live progress refresh interval (µs)
readonly ITEM_RE='^(https?|ftps?|sftp)://|^magnet:'       # a URL line in an aria2 input file (options are indented)

output_dir="" jobs=$DEFAULT_JOBS connections=$DEFAULT_CONNECTIONS limit="" session_file=$DEFAULT_SESSION
force=0 keep_list=0 allow_install=1 install_deps=0
sources=() LIST_FILES=() URLS=() ARIA_ARGS=() NORM=()
PM="" PM_LOG="" NETWORK_STATE="" INPUT_FILE="" source_label="" aria_rc=0 aria_running=0 interrupted=0
total_items=0 finished=0 ok=0 fail=0 skipped=0 total_bytes=0 NAME_COL=24 frame=0 remaining=0
exc_pending=0 exc_uri="" exc_code=0 exc_msg="" last_event=0 last_line_us=0 tick_us=0
idle_ticks=0 stopping=0 rpc_port=0 rpc_secret="" aria_pid="" ACT_DONE=() ACT_TOTAL=() ACT_SPEED=()
started_at=$SECONDS

# ══ UI layer ══════════════════════════════════════════════════════════════════
COLOR_LEVEL=0   # 0 = none, 1 = 16 colors, 2 = 256 colors, 3 = truecolor
C_RESET="" C_BOLD="" C_ACC="" C_OK="" C_WARN="" C_ERR="" C_MUTED=""
UI_TTY=0 UI_COLS=80 RULE_W=62 BAR_W=26 BAR_COL=""
readonly LOGO_RAMP=(99 105 141 177 213 219)               # violet → pink

init_ui() {
    [[ -t 1 ]] && UI_TTY=1
    if (( UI_TTY )); then
        UI_COLS=$(tput cols 2>/dev/null || echo 80)
        if [[ -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
            COLOR_LEVEL=1
            if [[ ${TERM:-} == *256color* || -n ${COLORTERM:-} ]]; then COLOR_LEVEL=2; fi
            if [[ ${COLORTERM:-} == *truecolor* || ${COLORTERM:-} == *24bit* ]]; then COLOR_LEVEL=3; fi
        fi
    fi
    if (( COLOR_LEVEL >= 1 )); then
        C_RESET=$'\e[0m' C_BOLD=$'\e[1m'
        if (( COLOR_LEVEL >= 2 )); then
            C_ACC=$'\e[38;5;141m' C_OK=$'\e[38;5;78m' C_WARN=$'\e[38;5;221m' C_ERR=$'\e[38;5;203m'
            C_MUTED=$'\e[38;5;244m'
        else
            C_ACC=$'\e[35m' C_OK=$'\e[32m' C_WARN=$'\e[33m' C_ERR=$'\e[31m'
            C_MUTED=$'\e[2m'
        fi
    fi
    RULE_W=$(( UI_COLS < 66 ? UI_COLS - 4 : 62 ))
    BAR_W=$(( UI_COLS >= 100 ? 30 : (UI_COLS >= 76 ? 24 : 14) ))
    if [[ ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} =~ [Uu][Tt][Ff]-?8 ]]; then
        G_OK="✔" G_FAIL="✖" G_SKIP="⊘" G_WARN="▲" G_STEP="◆" G_ARROW="→" G_DOT="·"
        G_TIMES="×" G_ELLIPSIS="…" G_H="─" G_V="│" G_TL="╭─" G_BL="╰"
        G_BAR_FULL="━" G_BAR_HEAD="╸" G_BAR_EMPTY="─" G_UNICODE=1
        G_SPIN=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
    else
        G_OK="+" G_FAIL="x" G_SKIP="-" G_WARN="!" G_STEP="*" G_ARROW="->" G_DOT="-"
        G_TIMES="x" G_ELLIPSIS="~" G_H="-" G_V="|" G_TL="+-" G_BL="+"
        G_BAR_FULL="#" G_BAR_HEAD="" G_BAR_EMPTY="-" G_UNICODE=0
        # shellcheck disable=SC1003
        G_SPIN=('|' '/' '-' '\')
    fi
}

rep() { # <string> <count>
    local out="" i
    for (( i = 0; i < $2; i++ )); do out+=$1; done
    printf '%s' "$out"
}

clip() { # <text> <max>
    if (( ${#1} > $2 )); then printf '%s%s' "${1:0:$2-1}" "$G_ELLIPSIS"; else printf '%s' "$1"; fi
}

pad() { # <text> <width>  (left-aligned, clipped)
    local text; text=$(clip "$1" "$2")
    printf '%s%s' "$text" "$(rep ' ' $(( $2 - ${#text} )))"
}

fmt_time() { # <seconds>
    local s=$1
    if (( s >= 3600 )); then
        printf '%d:%02d:%02d' $(( s / 3600 )) $(( s % 3600 / 60 )) $(( s % 60 ))
    else
        printf '%d:%02d' $(( s / 60 )) $(( s % 60 ))
    fi
}

human_bytes() { # <bytes>
    local units=(B KB MB GB TB) unit=0 tenths=$(( $1 * 10 ))
    while (( tenths >= 10240 && unit < 4 )); do tenths=$(( tenths / 1024 )); unit=$(( unit + 1 )); done
    if (( unit == 0 )); then printf '%d B' "$1"; else printf '%d.%d %s' $(( tenths / 10 )) $(( tenths % 10 )) "${units[unit]}"; fi
}

now_us() { if [[ -n ${EPOCHREALTIME:-} ]]; then REPLY=${EPOCHREALTIME/[.,]}; else REPLY=$(( SECONDS * 1000000 )); fi; }

# Decodes %XX only where XX is hex (a literal % or \ stays as it is) and shows control characters as "?",
# so a crafted URL cannot inject terminal escape sequences. No subshell: the result is in REPLY.
url_decode() { # <text> → REPLY
    local s=$1 out="" ch
    while [[ $s =~ ^([^%]*)%([0-9A-Fa-f]{2})(.*)$ ]]; do
        printf -v ch "\\x${BASH_REMATCH[2]}"
        out+=${BASH_REMATCH[1]}$ch
        s=${BASH_REMATCH[3]}
    done
    out+=$s
    REPLY=${out//[[:cntrl:]]/?}
}

url_name() { # <url> → REPLY: the file name aria2 will most likely use
    if [[ $1 == magnet:* ]]; then REPLY="magnet link"; return 0; fi
    local u=${1%%[?#]*} name
    u=${u%/}; name=${u##*/}
    if [[ $u == *://*/* && -n $name ]]; then url_decode "$name"; else url_decode "${u#*://}"; fi
}

url_scheme() { local s=${1%%:*}; printf '%s' "${s^^}"; }

# Colored pill with a short label (plain "[LABEL]" without colors).
badge() { # <label>
    local label=$1 bg=""
    if (( COLOR_LEVEL >= 2 )); then
        case $label in HTTPS) bg=141 ;; HTTP) bg=221 ;; FTP|FTPS|SFTP) bg=215 ;; MAGNET) bg=213 ;; *) bg=245 ;; esac
        printf '\e[48;5;%d;38;5;16m %s %s' "$bg" "$label" "$C_RESET"
    elif (( COLOR_LEVEL == 1 )); then
        case $label in HTTPS) bg=45 ;; HTTP) bg=43 ;; FTP|FTPS|SFTP) bg=41 ;; MAGNET) bg=45 ;; *) bg=47 ;; esac
        printf '\e[30;%dm %s %s' "$bg" "$label" "$C_RESET"
    else
        printf '[%s]' "$label"
    fi
}

info() { printf '%s\n' "$*"; }
note() { printf '  %s%s%s\n' "$C_MUTED" "$*" "$C_RESET"; }
step() { printf '  %s%s%s %s\n' "$C_ACC" "$G_STEP" "$C_RESET" "$*"; }
warn() { printf '  %s%s %s%s\n' "$C_WARN" "$G_WARN" "$*" "$C_RESET" >&2; }
die() { # <message> [hint ...]
    printf '\n  %s%s %s%s\n' "$C_ERR" "$G_FAIL" "$1" "$C_RESET" >&2
    shift
    local hint
    for hint in "$@"; do printf '    %s%s%s\n' "$C_MUTED" "$hint" "$C_RESET" >&2; done
    printf '\n' >&2
    exit 1
}

# ── Cards: a titled block with a left gutter ──────────────────────────────────
card_open()  { printf '\n  %s%s %s%s%s %s%s\n' "$C_MUTED" "$G_TL" "$C_BOLD$C_ACC" "$1" "$C_RESET$C_MUTED" "$(rep "$G_H" $(( RULE_W - ${#1} - 4 )))" "$C_RESET"; }
card_line()  { printf '  %s%s%s%s\n' "$C_MUTED" "$G_V" "$C_RESET" "${1:+ $1}"; }
card_row()   { card_line "$(printf '%s%-10s%s %s' "$C_MUTED" "$1" "$C_RESET" "$2")"; }
card_close() { printf '  %s%s%s%s\n' "$C_MUTED" "$G_BL" "$(rep "$G_H" $(( RULE_W - 1 )))" "$C_RESET"; }

hide_cursor() { if (( UI_TTY )); then printf '\e[?25l'; fi; return 0; }
show_cursor() { if (( UI_TTY )); then printf '\e[?25h'; fi; return 0; }

# ── Progress bars ─────────────────────────────────────────────────────────────
# Sets BAR_COL to the color of cell <i> of <width> (smooth violet→pink gradient on truecolor terminals).
bar_color() { # <i> <width>
    if (( COLOR_LEVEL >= 3 )); then
        local w=$(( $2 > 1 ? $2 - 1 : 1 ))
        printf -v BAR_COL '\e[38;2;%d;%d;%dm' $(( 140 + 115 * $1 / w )) $(( 100 + 10 * $1 / w )) $(( 255 - 45 * $1 / w ))
    else
        BAR_COL=$C_ACC
    fi
}

make_bar() { # <pct 0-100> <width>
    local pct=$1 width=$2 cells head=0 i out="" empty
    cells=$(( pct * width / 100 ))
    if [[ -n $G_BAR_HEAD ]] && (( cells < width && pct * width % 100 >= 50 )); then head=1; fi
    for (( i = 0; i < cells; i++ )); do bar_color "$i" "$width"; out+="$BAR_COL$G_BAR_FULL"; done
    if (( head )); then bar_color "$cells" "$width"; out+="$BAR_COL$G_BAR_HEAD"; fi
    empty=$(( width - cells - head ))
    printf '%s%s%s%s%s' "$out" "$C_RESET" "$C_MUTED" "$(rep "$G_BAR_EMPTY" "$empty")" "$C_RESET"
}

# ── Logo & banners ────────────────────────────────────────────────────────────
print_logo() {
    local -a rows=(
        "██████╗ ███╗   ██╗███████╗ █████╗ ████████╗"
        "██╔══██╗████╗  ██║██╔════╝██╔══██╗╚══██╔══╝"
        "██║  ██║██╔██╗ ██║█████╗  ███████║   ██║   "
        "██║  ██║██║╚██╗██║██╔══╝  ██╔══██║   ██║   "
        "██████╔╝██║ ╚████║███████╗██║  ██║   ██║   "
        "╚═════╝ ╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝   ╚═╝   "
    )
    local i
    printf '\n'
    if (( G_UNICODE && UI_COLS >= 52 )); then
        for i in "${!rows[@]}"; do
            if (( COLOR_LEVEL >= 2 )); then printf '  \e[38;5;%dm%s%s\n' "${LOGO_RAMP[i]}" "${rows[i]}" "$C_RESET"
            else printf '  %s%s%s\n' "$C_ACC" "${rows[i]}" "$C_RESET"; fi
        done
    else
        printf '  %s%sdneat%s\n' "$C_BOLD" "$C_ACC" "$C_RESET"
    fi
}

run_banner() {
    printf '\n  %s%s%s dneat%s  %ssmart batch downloader %s resumable multi-connection %s v%s%s\n' \
        "$C_ACC" "$C_BOLD" "$G_STEP" "$C_RESET" "$C_MUTED" "$G_ARROW" "$G_DOT" "$VERSION" "$C_RESET"
}

print_system() {
    local cpu os
    cpu=$(awk -F: '/model name/ { gsub(/^ +/, "", $2); print $2; exit }' /proc/cpuinfo 2>/dev/null || true)
    # shellcheck disable=SC1091
    os=$( (. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-Linux}") || echo Linux)
    card_open "System"
    card_row "OS" "$os"
    card_row "CPU" "$(clip "${cpu:-$(uname -m)}" $(( UI_COLS - 18 )))"
    card_close
}

print_plan() {
    local jobs_line limit_line
    if (( jobs == 1 )); then jobs_line="1 file at a time"; else jobs_line="$jobs files at a time"; fi
    if [[ -n $limit ]]; then limit_line="max ${limit%[KM]} ${limit: -1}B/s"; [[ $limit == *[KM] ]] || limit_line="max $limit B/s"; else limit_line="no speed limit"; fi
    card_open "Plan"
    card_row "Source" "$source_label $G_DOT $total_items URL(s)"
    card_row "Output" "$output_dir"
    card_row "Engine" "aria2 $(aria2c --version | awk 'NR == 1 { print $3 }')"
    card_row "Transfer" "$jobs_line $G_DOT $connections connection(s) per file $G_DOT $limit_line"
    card_row "Existing" "$( (( force )) && echo "replaced (--force)" || echo "skipped (use -f to replace)")"
    card_row "Resume" "$session_file"
    card_close
    printf '\n'
}

cleanup() {
    show_cursor
    [[ -z $aria_pid ]] || kill "$aria_pid" 2>/dev/null || true
    [[ -z $INPUT_FILE ]] || rm -f "$INPUT_FILE"
    [[ -z $PM_LOG ]] || rm -f "$PM_LOG"
}

# While aria2 runs, Ctrl-C / TERM / HUP only set a flag and ask aria2 to shut down gracefully (it writes its session
# file and closes its output, which ends the main loop). Anywhere else the script stops right away.
report_interrupted() {
    clear_live
    show_cursor
    printf '\n  %s%s Interrupted%s\n' "$C_WARN" "$G_WARN" "$C_RESET"
    remaining=$(( $(count_items "$session_file") - skipped ))
    if (( remaining > 0 )); then note "$remaining unfinished URL(s) saved $G_ARROW continue with: $(resume_command)"; fi
    printf '\n'
    exit 130
}
stop_aria2() { if (( aria_running )); then interrupted=1; halt_aria2; else report_interrupted; fi; }
trap cleanup EXIT
trap stop_aria2 INT TERM HUP

# ══ Help ══════════════════════════════════════════════════════════════════════
help_opt() { # <flags> <description> [default]
