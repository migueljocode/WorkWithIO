# ══ CLI ═══════════════════════════════════════════════════════════════════════
declare -A LONG_VALUE=([input]=i [output]=o [output-dir]=o [jobs]=j [connections]=c [limit]=l [session]=s)
declare -A LONG_FLAG=([force]=f [keep-list]=k [no-install]=n [install-deps]=y [install]=y [help]=h [version]=V)

# Rewrites --long options into their short equivalents so getopts can handle everything.
normalize_args() {
    NORM=()
    local arg name
    while (( $# > 0 )); do
        arg=$1; shift
        case $arg in
            --)    NORM+=(-- "$@"); break ;;
            --*=*) name=${arg%%=*}; name=${name#--}
                   if [[ -z ${LONG_VALUE[$name]:-} ]]; then
                       [[ -n ${LONG_FLAG[$name]:-} ]] && die "Option --$name does not take a value." || die "Unknown option '--$name'." "Run 'dneat --help' to see all options."
                   fi
                   NORM+=("-${LONG_VALUE[$name]}" "${arg#*=}") ;;
            --*)   name=${arg#--}
                   if [[ -n ${LONG_VALUE[$name]:-} ]]; then
                       (( $# > 0 )) || die "Option $arg requires a value."
                       NORM+=("-${LONG_VALUE[$name]}" "$1"); shift
                   elif [[ -n ${LONG_FLAG[$name]:-} ]]; then
                       NORM+=("-${LONG_FLAG[$name]}")
                   else
                       die "Unknown option '$arg'." "Run 'dneat --help' to see all options."
                   fi ;;
            *)     NORM+=("$arg") ;;
        esac
    done
}

validate_count() { [[ $1 =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 16 )); }
validate_limit() { [[ $1 =~ ^[0-9]+([.][0-9]+)?[KkMm]?$ ]]; }

parse_args() {
    local opt
    normalize_args "$@"
    set -- "${NORM[@]}"
    while getopts ":i:o:j:c:l:s:fknyVh" opt; do
        case $opt in
            i) sources+=("$OPTARG") ;;
            o) output_dir=$OPTARG ;;
            j) jobs=$OPTARG ;;
            c) connections=$OPTARG ;;
            l) limit=${OPTARG^^} ;;
            s) session_file=$OPTARG ;;
            f) force=1 ;;
            k) keep_list=1 ;;
            n) allow_install=0 ;;
            y) install_deps=1 ;;
            V) echo "dneat $VERSION"; exit 0 ;;
            h) show_help; exit 0 ;;
            :) die "Option -$OPTARG requires a value." ;;
            *) die "Unknown option -$OPTARG." "Run 'dneat --help' to see all options." ;;
        esac
    done
    shift $(( OPTIND - 1 ))
    sources+=("$@")
    validate_count "$jobs" || die "Jobs must be a number from 1 to 16."
    validate_count "$connections" || die "Connections must be a number from 1 to 16."
    jobs=$(( 10#$jobs )); connections=$(( 10#$connections ))
    if [[ -n $limit ]]; then validate_limit "$limit" || die "Invalid speed limit '$limit'." "Use a number with an optional K or M, e.g. 500K or 2M."; fi
    if [[ $limit == *.* ]]; then limit=$(awk -v v="${limit%[KM]}" -v u="${limit: -1}" 'BEGIN { k = v * (u == "M" ? 1024 : u == "K" ? 1 : 1 / 1024); printf "%dK", k < 1 ? 1 : k }'); fi   # 1.5M → 1536K
}

require_linux() {
    [[ $(uname -s) == Linux ]] || die "This is the Linux script. Use dneat.zsh (macOS) or dneat.ps1 (Windows)."
}

# ══ Package management ════════════════════════════════════════════════════════
detect_pkg_manager() {
    local pm
    for pm in apt-get dnf pacman zypper; do
        if command -v "$pm" &>/dev/null; then echo "$pm"; return 0; fi
    done
    return 0
}

as_root() {
    if (( EUID == 0 )); then "$@"
    elif command -v sudo &>/dev/null; then sudo "$@"
    else warn "Root privileges required (sudo not found)."; return 1
    fi
}

# ── Connectivity ──────────────────────────────────────────────────────────────
probe_network() {
    case ${DNEAT_NETWORK:-} in online) return 0 ;; offline) return 1 ;; esac
    if [[ -n ${https_proxy:-${HTTPS_PROXY:-${http_proxy:-${HTTP_PROXY:-}}}} ]]; then return 0; fi
    local host
    for host in 1.1.1.1 8.8.8.8; do
        if timeout 2 bash -c "exec 3<>/dev/tcp/$host/443" 2>/dev/null; then return 0; fi
    done
    getent hosts example.com &>/dev/null
}

has_network() {
    if [[ -z $NETWORK_STATE ]]; then
        if probe_network; then NETWORK_STATE=up; else NETWORK_STATE=down; fi
    fi
    [[ $NETWORK_STATE == up ]]
}

# ── Package manager runs (output captured so failures can be explained) ───────
run_logged() { # <command...> → runs as root, all output goes to $PM_LOG
    : >"$PM_LOG"
    as_root "$@" >>"$PM_LOG" 2>&1
}

classify_pm_failure() {
    local log; log=$(<"$PM_LOG")
    if grep -Eqi 'could not resolve|temporary failure|name or service not known|network is unreachable|no route to host|failed to fetch|could not connect|cannot initiate|connection (timed out|refused|failed)|curl error|failed to download|unable to connect|failed to synchronize|failed retrieving|download failed' <<<"$log"; then echo network
    elif grep -Eqi 'unable to locate package|no match for argument|target not found|unable to find a match|has no installation candidate|not found in package names|nothing provides' <<<"$log"; then echo missing
    elif grep -Eqi 'could not get lock|unable to acquire the dpkg|waiting for process|another process|already locked|is locked' <<<"$log"; then echo busy
    elif grep -Eqi 'a password is required|incorrect password|authentication failure|a terminal is required|sudo:' <<<"$log"; then echo auth
    else echo other
    fi
}

report_pm_failure() { # <what failed>
    local last
    case $(classify_pm_failure) in
        network) NETWORK_STATE=down; warn "$1: network problem – check your internet connection." ;;
        missing) warn "$1: package not found in your configured repositories." ;;
        busy)    warn "$1: another package manager is running – wait for it to finish, then re-run." ;;
        auth)    warn "$1: administrator (sudo) authentication failed." ;;
        *)       last=$(grep -v '^[[:space:]]*$' "$PM_LOG" | tail -n 1 | cut -c1-110 || true)
                 warn "$1${last:+: $last}" ;;
    esac
}

manual_install_hint() { # <package>...
    case $PM in
        apt-get) echo "sudo apt install $*" ;;
        dnf)     echo "sudo dnf install $*" ;;
        pacman)  echo "sudo pacman -S $*" ;;
        zypper)  echo "sudo zypper install $*" ;;
        *)       echo "install: $* (with your package manager)" ;;
    esac
}

pm_refresh() {
    case $PM in
        apt-get) run_logged apt-get update -qq || { report_pm_failure "Could not refresh package lists"; return 1; } ;;
        zypper)  run_logged zypper --non-interactive -q refresh || { report_pm_failure "Could not refresh package lists"; return 1; } ;;
    esac
    return 0
}

pm_install() {
    case $PM in
        apt-get) run_logged env DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@" ;;
        dnf)     run_logged dnf install -y -q "$@" ;;
        pacman)  run_logged pacman -S --needed --noconfirm "$@" ;;
        zypper)  run_logged zypper --non-interactive -q install "$@" ;;
    esac
}

# Installs one package; on failure explains why and returns 1.
install_package() { # <package>
    step "Installing $1"
    if pm_install "$1"; then return 0; fi
    report_pm_failure "Could not install $1"
    return 1
}

# ══ Prerequisites ═════════════════════════════════════════════════════════════
ensure_aria2() {
    if command -v aria2c &>/dev/null; then return 0; fi
    (( allow_install )) || die "aria2 is not installed (auto-install disabled)." "Install it manually: $(manual_install_hint aria2)"
    [[ -n $PM ]] || die "aria2 is not installed and no supported package manager was found." "Install aria2 manually: https://aria2.github.io"
    has_network || die "aria2 is not installed and there is no internet connection." \
        "Connect to the network and run again, or install it manually: $(manual_install_hint aria2)"
    pm_refresh || true
    install_package aria2 || true
    command -v aria2c &>/dev/null || die "aria2 installation failed." "Install it manually: $(manual_install_hint aria2)"
}

clipboard_package() { if [[ -n ${WAYLAND_DISPLAY:-} ]]; then echo wl-clipboard; else echo xclip; fi; }

has_clipboard_tool() {
    command -v xclip &>/dev/null || command -v wl-paste &>/dev/null || command -v xsel &>/dev/null
}

read_clipboard() {
    if   [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-paste &>/dev/null; then wl-paste --no-newline 2>/dev/null
    elif command -v xclip &>/dev/null; then xclip -selection clipboard -o 2>/dev/null
    elif command -v xsel &>/dev/null; then xsel --clipboard --output 2>/dev/null
    elif command -v wl-paste &>/dev/null; then wl-paste --no-newline 2>/dev/null
    else return 1
    fi
}

ensure_clipboard() {
    if has_clipboard_tool; then return 0; fi
    local pkg; pkg=$(clipboard_package)
    (( allow_install )) || die "No clipboard tool is installed (auto-install disabled)." "Install one manually: $(manual_install_hint "$pkg")" "Or pass URLs / a list file as arguments."
    [[ -n $PM ]] || die "No clipboard tool is installed and no supported package manager was found." "Pass URLs / a list file as arguments instead."
    has_network || die "No clipboard tool is installed and there is no internet connection." "Install one manually: $(manual_install_hint "$pkg")"
    pm_refresh || true
    install_package "$pkg" || true
    has_clipboard_tool || die "Clipboard tool installation failed." "Install it manually: $(manual_install_hint "$pkg")" "Or pass URLs / a list file as arguments."
}

# -y: make sure aria2 and a clipboard helper are present.
ensure_dependencies() {
    (( allow_install )) || { warn "-n (no install) takes precedence over -y – nothing was installed."; return 1; }
    [[ -n $PM ]] || { warn "No supported package manager found – nothing was installed."; return 1; }
    has_network || { warn "No internet connection – dependencies were not installed."; return 1; }
    ensure_aria2
    ensure_clipboard
    note "aria2 and a clipboard helper are ready."
}

# ══ Input ═════════════════════════════════════════════════════════════════════
count_items() { # <aria2 input file> → number of URL lines
    [[ -s $1 ]] || { echo 0; return 0; }
    grep -cE "$ITEM_RE" "$1" || true
}

same_file() { [[ -e $1 && -e $2 && $(realpath -- "$1") == "$(realpath -- "$2")" ]]; }

resume_command() {
    local cmd="dneat"        # aria2 stores each download's folder in the session file, so -o is not needed
    if [[ $session_file != "$DEFAULT_SESSION" ]]; then cmd+=" -s $(printf '%q' "$session_file")"; fi
    printf '%s %q' "$cmd" "$session_file"
}

# Builds one aria2 input file from the clipboard, URLs and list files (list files are copied as they are).
build_input() {
    local item n_urls=0 n_files=0 clip_text
    : >"$INPUT_FILE"
    if (( ${#sources[@]} == 0 )); then
        ensure_clipboard
        step "Reading URLs from the clipboard…"
        clip_text=$(read_clipboard || true)
        grep -Eo "$URL_RE" <<<"$clip_text" | sed -E "s/[].,;:!?)>\"']+\$//" >"$INPUT_FILE" || true
        [[ -s $INPUT_FILE ]] || die "No URLs found on the clipboard." "Copy one or more http(s)/ftp links, or pass URLs / a list file as arguments."
        source_label="clipboard"
    else
        for item in "${sources[@]}"; do
            if [[ $item =~ $ITEM_RE ]]; then
                printf '%s\n' "$item" >>"$INPUT_FILE"; n_urls=$(( n_urls + 1 ))
            elif [[ -f $item ]]; then
                tr -d '\r' <"$item" >>"$INPUT_FILE"; printf '\n' >>"$INPUT_FILE"; n_files=$(( n_files + 1 ))
                if ! same_file "$item" "$session_file"; then LIST_FILES+=("$item"); fi
            else
                die "'$item' is neither a URL nor an existing file." "Run 'dneat --help' for usage."
            fi
        done
        if (( n_files > 0 && n_urls > 0 )); then source_label="$n_files list file(s) + command line"
        elif (( n_files > 0 )); then source_label="$n_files list file(s)"
        else source_label="command line"; fi
    fi
    total_items=$(count_items "$INPUT_FILE")
    (( total_items > 0 )) || die "No URLs found." "A list file needs one URL per line."
    mapfile -t URLS < <(grep -E "$ITEM_RE" "$INPUT_FILE" | cut -f1 | cut -d' ' -f1)
}

# A leftover session from an earlier run is replaced by this run's – tell the user before that happens.
warn_stale_session() {
    local item left
    for item in "${sources[@]}"; do if same_file "$item" "$session_file"; then return 0; fi; done
    left=$(count_items "$session_file")
    if (( left > 0 )); then
        warn "$session_file still holds $left unfinished URL(s) from an earlier run – it will be replaced."
        note "To continue them instead, stop now and run: $(resume_command)"
    fi
}

compute_layout() {
    local u longest=0
    for u in "${URLS[@]}"; do url_name "$u"; if (( ${#REPLY} > longest )); then longest=${#REPLY}; fi; done
    NAME_COL=$(( UI_COLS - 60 ))
    if (( NAME_COL < 14 )); then NAME_COL=14; fi
    if (( NAME_COL > 40 )); then NAME_COL=40; fi
    if (( longest < NAME_COL )); then NAME_COL=$longest; fi
    if (( NAME_COL < 8 )); then NAME_COL=8; fi
}

file_bytes() { if [[ -f $1 ]]; then echo $(( $(wc -c <"$1") )); else echo 0; fi; }

# ══ Progress & reporting ══════════════════════════════════════════════════════
clear_live() { if (( UI_TTY )); then printf '\r\e[2K\n\e[2K\e[1A\r'; fi; return 0; }

# Two live lines: the current file (spinner, bar, speed, ETA, protocol) and the whole batch.
draw_live() { # <pct|-1> <speed> <eta> <active> <overall pct>
    local pct=$1 speed=$2 eta=$3 active=$4 opct=$5
    local idx=$(( finished + 1 )) tag name label plain colored bar="" badge_w avail bw=0 obw name_max prefix_w l1 l2 spin
    if (( jobs == 1 )); then
        if (( idx > total_items )); then idx=$total_items; fi
        tag="[$idx/$total_items]"
        url_name "${URLS[idx-1]:-}"; name=$REPLY; label=$(url_scheme "${URLS[idx-1]:-?}")
    else
        tag="[$finished/$total_items]"
        name="$active active"; label="$G_TIMES$active"
    fi
    badge_w=$(( ${#label} + 2 ))
    if (( pct >= 0 )); then
        printf -v plain '%3d%%  %9s  ETA %-5s' "$pct" "$speed" "$eta"
        printf -v colored '%s%3d%%%s  %s%9s  ETA %-5s%s' "$C_BOLD" "$pct" "$C_RESET" "$C_MUTED" "$speed" "$eta" "$C_RESET"
    else
        printf -v plain '%7s  %9s' "$(fmt_time $(( SECONDS - started_at )))" "$speed"
        colored="$C_MUTED$plain$C_RESET"
    fi
    avail=$(( UI_COLS - (2 + 1 + 1 + ${#tag} + 1 + 1 + ${#plain} + 2 + badge_w) - 1 ))   # room for the name and the bar
    if (( pct >= 0 )); then
        bw=$(( avail - 15 )); if (( bw > BAR_W )); then bw=$BAR_W; fi
        if (( bw < 8 )); then bw=0; fi
    fi
    if (( bw > 0 )); then bar="$(make_bar "$pct" "$bw") "; name_max=$(( avail - bw - 1 )); else name_max=$avail; fi
    if (( name_max < 10 )); then name_max=10; fi
    prefix_w=$(( 2 + 1 + 1 + ${#tag} + 1 + name_max + 1 ))
    if (( bw > 0 )); then obw=$bw; else obw=$(( UI_COLS - prefix_w - 24 )); if (( obw > BAR_W )); then obw=$BAR_W; fi; if (( obw < 6 )); then obw=6; fi; fi
    spin=${G_SPIN[frame % ${#G_SPIN[@]}]}
    printf -v l1 '  %s%s%s %s%s%s %s%s%s %s%s  %s' "$C_ACC" "$spin" "$C_RESET" "$C_MUTED" "$tag" "$C_RESET" \
        "$C_BOLD" "$(pad "$name" "$name_max")" "$C_RESET" "$bar" "$colored" "$(badge "$label")"
    printf -v l2 '%s%*s%s %s  %s%3d%%  %s elapsed%s' "$C_MUTED" $(( prefix_w - 1 )) "overall" "$C_RESET" \
        "$(make_bar "$opct" "$obw")" "$C_MUTED" "$opct" "$(fmt_time $(( SECONDS - started_at )))" "$C_RESET"
    printf '\r\e[2K%s\n\e[2K%s\e[1A\r' "$l1" "$l2"
}

# aria2's own console readout is block-buffered on a pipe (so it arrives in bursts) and is capped at once per second.
# Instead the script asks aria2's local JSON-RPC server for the numbers every TICK_US, over bash's /dev/tcp (no forks).
rpc() { # <method> [params-json] → REPLY = response body; fails quietly while aria2 is still starting
    local body fd
    printf -v body '{"jsonrpc":"2.0","id":"d","method":"%s","params":["token:%s"%s]}' "$1" "$rpc_secret" "${2:+,$2}"
    { exec {fd}<>"/dev/tcp/127.0.0.1/$rpc_port"; } 2>/dev/null || return 1
    printf 'POST /jsonrpc HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/json\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s' \
        "${#body}" "$body" >&"$fd" 2>/dev/null || { exec {fd}>&-; return 1; }
    IFS= read -r -d '' -t 2 -u "$fd" REPLY || true
    exec {fd}>&-
    REPLY=${REPLY#*$'\r\n\r\n'}
}

scan_json() { # <key> <array> : every "key":"<number>" in $REPLY, in order
    local -n out=$2; local s=$REPLY re="\"$1\":\"([0-9]+)\""
    out=()
    while [[ $s =~ $re ]]; do out+=("${BASH_REMATCH[1]}"); s=${s#*"${BASH_REMATCH[0]}"}; done
}

poll_progress() {
    (( UI_TTY )) || return 0
    local pct=-1 speed="--" eta="--:--" i n=0 sum=0 known=0 bps=0 left=0 opct elapsed=$(( SECONDS - started_at ))
    if rpc aria2.tellActive '["completedLength","totalLength","downloadSpeed"]'; then
        scan_json completedLength ACT_DONE; scan_json totalLength ACT_TOTAL; scan_json downloadSpeed ACT_SPEED
        n=${#ACT_DONE[@]}
        for (( i = 0; i < n; i++ )); do
            bps=$(( bps + ACT_SPEED[i] ))
            if (( ACT_TOTAL[i] > 0 )); then
                sum=$(( sum + 100 * ACT_DONE[i] / ACT_TOTAL[i] )); known=$(( known + 1 )); left=$(( left + ACT_TOTAL[i] - ACT_DONE[i] ))
            fi
        done
        if (( n > 0 )); then speed="$(human_bytes "$bps")/s"; fi
        if (( known > 0 )); then pct=$(( sum / known )); fi
    fi
    opct=$(( (finished * 100 + sum) / total_items ))
    if (( opct > 100 )); then opct=100; fi
    if (( (jobs == 1 || n <= 1) && bps > 0 && known > 0 )); then
        eta=$(fmt_time $(( left / bps )))
    elif (( opct > 0 && opct < 100 && elapsed > 0 )); then
        eta=$(fmt_time $(( elapsed * (100 - opct) / opct )))
    fi
    frame=$(( frame + 1 ))
    draw_live "$pct" "$speed" "$eta" "$(( n < 1 ? 1 : n ))" "$opct"
}

report_ok() { # <tag> <name> <bytes> <seconds|-1>
    local speed="" secs=""
    if (( $4 >= 0 )); then
        secs=$(fmt_time "$4")
        if (( $4 > 0 )); then speed="$(human_bytes $(( $3 / $4 )))/s"; else speed="--"; fi
    fi
    printf '  %s%s%s %s%s%s %s%s%s  %9s  %s%10s  %5s%s\n' \
        "$C_OK" "$G_OK" "$C_RESET" "$C_MUTED" "$1" "$C_RESET" "$C_BOLD" "$(pad "$2" "$NAME_COL")" "$C_RESET" \
        "$(human_bytes "$3")" "$C_MUTED" "$speed" "$secs" "$C_RESET"
}

report_note() { # <fail|skip> <tag> <name> <detail>
    local glyph color room
    if [[ $1 == fail ]]; then glyph=$G_FAIL color=$C_ERR; else glyph=$G_SKIP color=$C_MUTED; fi
    room=$(( UI_COLS - ${#2} - NAME_COL - 8 ))
    if (( room < 10 )); then room=10; fi
    printf '  %s%s%s %s%s%s %s%s%s  %s%s%s\n' "$color" "$glyph" "$C_RESET" "$C_MUTED" "$2" "$C_RESET" \
        "$C_BOLD" "$(pad "$3" "$NAME_COL")" "$C_RESET" "$color" "$(clip "$4" "$room")" "$C_RESET"
}

handle_complete() { # <path>
    local path=$1 bytes secs now=$SECONDS
    bytes=$(file_bytes "$path")
    finished=$(( finished + 1 )); ok=$(( ok + 1 )); total_bytes=$(( total_bytes + bytes ))
    if (( jobs == 1 )); then secs=$(( now - last_event )); else secs=-1; fi
    last_event=$now
    clear_live
    report_ok "[$finished/$total_items]" "${path##*/}" "$bytes" "$secs"
}

# "Exception: … errorCode=3 …" (+ "  -> … errorCode=3 Resource not found"): the last errorCode/message pair wins.
parse_exception() { # <line>
    if [[ $1 =~ ^.*errorCode=([0-9]+)\ ?(.*)$ ]]; then exc_code=${BASH_REMATCH[1]}; exc_msg=${BASH_REMATCH[2]}; fi
}

friendly_reason() { # <message>
    local msg=$1
    if [[ $msg =~ status=([0-9]+) ]]; then printf 'HTTP %s' "${BASH_REMATCH[1]}"; else printf '%s' "${msg%.}"; fi
}

flush_failure() {
    url_name "$exc_uri"; local name=$REPLY
    exc_pending=0 last_event=$SECONDS
    finished=$(( finished + 1 ))
    clear_live
    if (( exc_code == 13 )); then
        skipped=$(( skipped + 1 )); report_note skip "[$finished/$total_items]" "$name" "already exists – use -f to replace"
    else
        fail=$(( fail + 1 )); report_note fail "[$finished/$total_items]" "$name" "failed: $(friendly_reason "$exc_msg")"
    fi
}

# One aria2 log line → the neat UI. (Progress comes from poll_progress, not from the log.)
handle_event() { # <line>
    if (( exc_pending )) && [[ $1 != Exception:* && $1 != '  ->'* ]]; then flush_failure; fi
    case $1 in
        *'[NOTICE] Download complete: '*)    handle_complete "${1##*Download complete: }" ;;
        *'[ERROR] '*'Download aborted. URI='*) exc_pending=1; exc_uri=${1##*URI=}; exc_code=0; exc_msg="" ;;
        Exception:*|'  ->'*)                 parse_exception "$1" ;;
    esac
}

# aria2 only wakes up once a second to look at signals, so after SIGINT a throwaway connection to its RPC port wakes it
# immediately (graceful: unfinished work and the session file are saved, exit takes milliseconds).
halt_aria2() {
    stopping=1
    kill -INT "$aria_pid" 2>/dev/null || true
    { exec 8<>"/dev/tcp/127.0.0.1/$rpc_port"; } 2>/dev/null && exec 8>&-
    return 0
}

# With RPC enabled aria2 keeps running after its queue is empty, so halt it once nothing is active or waiting
# (one look is enough when every URL has reported back, otherwise two ticks in a row).
shutdown_when_idle() {
    (( stopping )) && return 0
    local -a active=() waiting=()
    local need=2
    rpc aria2.getGlobalStat || return 0
    scan_json numActive active; scan_json numWaiting waiting
    if (( ${#active[@]} == 1 && ${#waiting[@]} == 1 )) && (( active[0] + waiting[0] == 0 )); then idle_ticks=$(( idle_ticks + 1 )); else idle_ticks=0; fi
    if (( finished >= total_items )); then need=1; fi
    if (( idle_ticks >= need )); then halt_aria2; fi
    return 0
}

free_port() { # → REPLY: a loopback port nobody listens on
    local p
    for p in $(shuf -i 49152-65535 -n 20); do
        if ! { exec 9<>"/dev/tcp/127.0.0.1/$p"; } 2>/dev/null; then REPLY=$p; return 0; fi
        exec 9>&-
    done
    return 1
}

run_aria2() {
    local line buf="" t left rc=0 fd launch=()
    free_port || die "No free local port for aria2's progress channel."
    rpc_port=$REPLY; rpc_secret=$(</proc/sys/kernel/random/uuid)
    ARIA_ARGS=(--input-file="$INPUT_FILE" --dir="$output_dir"
        --max-concurrent-downloads="$jobs" --split="$connections" --max-connection-per-server="$connections"
        --summary-interval=0 --show-console-readout=false --console-log-level=notice --enable-color=false --download-result=hide
        --auto-file-renaming=false --save-session="$session_file" --save-session-interval=60
        --enable-rpc --rpc-listen-port="$rpc_port" --rpc-secret="$rpc_secret" --stop-with-process=$$)
    if (( force )); then ARIA_ARGS+=(--allow-overwrite=true); fi
    if [[ -n $limit ]]; then ARIA_ARGS+=(--max-overall-download-limit="$limit"); fi
    if command -v setsid &>/dev/null; then launch+=(setsid); fi             # own session: a terminal Ctrl-C reaches only us, and we halt aria2 once
    if command -v stdbuf &>/dev/null; then launch+=(stdbuf -oL -eL); fi    # without it aria2 buffers its log lines too
    last_event=$SECONDS
    hide_cursor
    aria_running=1
    trap '' PIPE                                                            # a dead aria2 must not kill us mid-write
    set +e   # Ctrl-C also reaches the short-lived $(...) subshells of the live UI and kills them; that must not abort the script
    coproc ARIA { exec "${launch[@]}" aria2c "${ARIA_ARGS[@]}" 2>&1; }
    aria_pid=$ARIA_PID
    exec {fd}<&"${ARIA[0]}"      # bash closes ARIA[0] and unsets ARIA / ARIA_PID as soon as aria2 exits; a copy keeps the unread tail
    poll_progress                                                           # first frame right away, not after aria2 warms up
    now_us; tick_us=$REPLY; last_line_us=$REPLY
    while :; do
        now_us; left=$(( tick_us + TICK_US - REPLY ))
        if (( left < 1000 )); then left=1000; fi
        printf -v t '0.%06d' "$left"
        if IFS= read -r -t "$t" -u "$fd" line; then
            handle_event "$buf$line"; buf=""; now_us; last_line_us=$REPLY
            if (( finished >= total_items )); then shutdown_when_idle; fi
        else
            rc=$?
            if (( rc <= 128 )); then break; fi                              # EOF: aria2 has exited
            buf+=$line                                                      # timeout: keep a partial line, if any
            now_us
            if (( exc_pending && REPLY - last_line_us > 200000 )); then flush_failure; fi   # failure report is complete
        fi
        now_us
        if (( REPLY - tick_us >= TICK_US )); then tick_us=$REPLY; poll_progress; shutdown_when_idle; fi
    done
    exec {fd}<&-
    wait "$aria_pid" || aria_rc=$?
    aria_pid=""
    trap - PIPE
    set -e
    if (( exc_pending )); then flush_failure; fi
    aria_running=0
    clear_live
    show_cursor
    if (( interrupted )); then report_interrupted; fi
}

# Unfinished URLs live in the session file; items skipped because they already exist are not "unfinished".
settle_session() {
    remaining=$(( $(count_items "$session_file") - skipped ))
    if (( remaining < 0 )); then remaining=0; fi
    if (( remaining == 0 )); then rm -f "$session_file"; fi
    return 0
}

print_summary() {
    local line wall=$(( SECONDS - started_at ))
    card_open "Summary"
    line="${C_OK}${G_OK} $ok downloaded${C_RESET}"
    if (( fail > 0 ));    then line+="   ${C_ERR}${G_FAIL} $fail failed${C_RESET}"; fi
    if (( skipped > 0 )); then line+="   ${C_MUTED}${G_SKIP} $skipped skipped${C_RESET}"; fi
    card_row "Result" "$line"
    if (( total_bytes > 0 )); then
        card_row "Size" "$(human_bytes "$total_bytes")"
        if (( wall > 0 )); then card_row "Speed" "$(human_bytes $(( total_bytes / wall )))/s average"; fi
    fi
    card_row "Time" "$(fmt_time "$wall")"
    card_row "Output" "$output_dir"
    if (( remaining > 0 )); then
        card_row "Resume" "${C_WARN}$remaining URL(s) left${C_RESET} $G_ARROW $(resume_command)"
    else
        card_row "Resume" "${C_MUTED}nothing left to resume${C_RESET}"
    fi
    card_close
    if (( fail == 0 )); then
        printf '\n  %s%s%s All done.%s\n\n' "$C_OK" "$C_BOLD" "$G_OK" "$C_RESET"
    else
        printf '\n  %s%s%s Finished with %d failure(s).%s\n\n' "$C_ERR" "$C_BOLD" "$G_FAIL" "$fail" "$C_RESET"
    fi
}

# Offers to delete the URL lists that were used (never the resume file – dneat manages that one).
offer_list_removal() {
    local list answer
    (( keep_list || ${#LIST_FILES[@]} == 0 )) && return 0
    [[ -t 0 && -t 1 ]] || return 0
    for list in "${LIST_FILES[@]}"; do
        [[ -f $list ]] || continue
        card_open "URL list"
        card_line "'$list' is no longer needed."
        if (( remaining > 0 )); then
            card_line "${C_MUTED}Finished downloads are on disk; the unfinished ones are saved in $session_file.${C_RESET}"
        else
            card_line "${C_MUTED}Everything in it has been handled.${C_RESET}"
        fi
        printf '  %s%s%s %sRemove it?%s %s[y/N]%s: ' "$C_MUTED" "$G_V" "$C_RESET" "$C_BOLD" "$C_RESET" "$C_MUTED" "$C_RESET"
        read -r answer || answer=""
        if [[ $answer =~ ^[Yy]$ ]]; then rm -f -- "$list"; card_line "${C_OK}${G_OK}${C_RESET} removed"; else card_line "${C_MUTED}kept${C_RESET}"; fi
        card_close
    done
}

# ══ Main ══════════════════════════════════════════════════════════════════════
main() {
    local rc
    init_ui
    require_linux
    parse_args "$@"
    PM=$(detect_pkg_manager)
    PM_LOG=$(mktemp "${TMPDIR:-/tmp}/dneat-pm.XXXXXX")
    INPUT_FILE=$(mktemp "${TMPDIR:-/tmp}/dneat.XXXXXX")
    run_banner; print_system

    if (( install_deps )); then
        ensure_dependencies || exit 1
        printf '\n  %s%s%s Dependency setup finished.%s %sRe-run without -y to download.%s\n\n' "$C_OK" "$C_BOLD" "$G_OK" "$C_RESET" "$C_MUTED" "$C_RESET"
        exit 0
    fi
    ensure_aria2
    build_input
    output_dir=${output_dir:-.}
    mkdir -p -- "$output_dir"
    output_dir=$(cd -- "$output_dir" && pwd)
    compute_layout
    warn_stale_session
    print_plan

    run_aria2
    if (( aria_rc != 0 && aria_rc != 13 && fail == 0 && skipped == 0 && ok < total_items )); then
        fail=1; warn "aria2 stopped with exit code $aria_rc."
    fi
    settle_session
    print_summary
    offer_list_removal
    (( fail == 0 ))
}

main "$@"
