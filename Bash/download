#!/usr/bin/env bash

set -u

resume_file="resume.session"
temp_file=""
used_file=false

cleanup() {
    if [[ -n "$temp_file" ]]; then
        rm -f "$temp_file"
    fi
}

trap cleanup EXIT


# Check dependencies
if ! command -v aria2c >/dev/null 2>&1; then
    echo "❌ Error: aria2c is not installed!" >&2
    exit 1
fi


# Determine URL source
if (( $# == 0 )); then
    # Use clipboard
    if ! command -v xclip >/dev/null 2>&1; then
        echo "❌ Error: xclip is not installed!" >&2
        exit 1
    fi

    temp_file="$(mktemp)"

    echo "📋 Reading URLs from clipboard..."

    xclip -selection clipboard -o |
        grep -Eo 'https?://[^[:space:]]+' > "$temp_file"

    if [[ ! -s "$temp_file" ]]; then
        echo "❌ Error: No URLs found in clipboard!" >&2
        exit 1
    fi

    url_file="$temp_file"

elif (( $# == 1 )); then
    # Use the supplied file
    url_file="$1"

    if [[ ! -f "$url_file" ]]; then
        echo "❌ Error: URL list file '$url_file' not found!" >&2
        exit 1
    fi

    # Only normal URL-list files should get the cleanup prompt.
    # resume.session is managed automatically by this script.
    if [[ "$(realpath -- "$url_file")" != "$(realpath -- "$resume_file")" ]]; then
        used_file=true
    fi

else
    echo "❌ Error: Too many arguments!" >&2
    echo
    echo "Usage:"
    echo "  download              Use URLs from clipboard"
    echo "  download urls.txt     Use URLs from a file"
    exit 1
fi


echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "📥 Starting download..."
echo "📄 URL list:    $url_file"
echo "📂 Directory:   $(pwd)"
echo "📌 Resume file: $resume_file"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"


aria2c --input-file="$url_file" \
    --max-concurrent-downloads=1 \
    --split=16 \
    --max-connection-per-server=16 \
    --summary-interval=0 \
    --console-log-level=error \
    --auto-file-renaming=false \
    --save-session="$resume_file" \
    --save-session-interval=60

exit_code=$?


# Remove an empty resume file
if [[ -f "$resume_file" && ! -s "$resume_file" ]]; then
    rm -f "$resume_file"
fi


echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"


if [[ "$exit_code" -eq 0 ]]; then
    echo "✅ Download completed successfully!"
else
    echo "⚠️  Download finished with errors (exit code: $exit_code)"
fi


# Check remaining downloads
if [[ -s "$resume_file" ]]; then

    remaining=$(grep -cE '^[[:space:]]*https?://[^[:space:]]' \
        "$resume_file" 2>/dev/null || true)

    if [[ "$remaining" -gt 0 ]]; then
        echo "⏳ $remaining URL(s) remaining — rerun with:"
        echo "   download $resume_file"
    else
        echo "🎉 All downloads completed."
        rm -f "$resume_file"
    fi

else
    echo "🎉 Nothing left to resume."
fi


echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"


# Ask whether to remove a normal user-supplied URL list.
# Do NOT ask for resume.session.
if [[ "$used_file" == true ]]; then

    cat <<EOF

ℹ️  '$url_file' is no longer needed.
   Completed downloads are already downloaded, and (Only if the download ran into a problem) unfinished ones
   are saved in '$resume_file'.
   

EOF

    read -rp "🗑️  Remove '$url_file'? [y/N] " answer

    if [[ "$answer" =~ ^[Yy]$ ]]; then
        rm -f "$url_file"
        echo "🗑️  '$url_file' removed."
    else
        echo "📄 '$url_file' kept."
    fi
fi


echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

exit "$exit_code"
