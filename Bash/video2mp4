#!/usr/bin/env bash
# video2mp4 – batch video → H.264/AAC MP4 converter
# Tries Intel VAAPI first; falls back to CPU (libx264) if it fails.

set -euo pipefail

DEFAULT_QUALITY=26
COMPRESSED_SUBDIR="compressed"
SUPPORTED_EXTS="mov mp4 mkv avi webm"

# ── Help ──────────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  video2mp4 – batch video → H.264 MP4 converter
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

USAGE
  video2mp4 [OPTIONS] [FILE ...]          # convert specific files
  video2mp4 [OPTIONS] -i <dir>            # convert all videos in a directory
  video2mp4 [OPTIONS]                     # convert current directory

OPTIONS
  -i <dir>    Input directory
  -o <dir>    Output directory (default: <input_dir>/compressed)
  -q <1-51>   Quality (VAAPI global_quality or x264 CRF)
  -t          Do NOT preserve original file modification/access times
              (default: ON — pass -t to toggle off)
  -h          Show this help

EXAMPLES
  video2mp4 -q 20          # high quality
  video2mp4 -i ~/Videos    # convert all videos in ~/Videos
  video2mp4 -i ./vids -t   # convert and disable timestamp preservation
EOF
    exit 0
}

# ── Parse arguments ──────────────────────────────────────────────────────────
input_dir=""
output_dir=""
quality="$DEFAULT_QUALITY"
preserve_times=1

while getopts "i:o:q:ht" opt; do
    case "$opt" in
        i) input_dir="$OPTARG" ;;
        o) output_dir="$OPTARG" ;;
        q) quality="$OPTARG" ;;
        t) preserve_times=0 ;; # default ON; pass -t to disable
        h) usage ;;
        *) usage ;;
    esac
done
shift $(( OPTIND - 1 ))
direct_files=("$@")

# Validate quality
if ! [[ "$quality" =~ ^[0-9]+$ ]] || (( quality < 1 || quality > 51 )); then
    echo "❌ Quality must be 1–51."; exit 1
fi

# Dependencies
for cmd in ffmpeg bc; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "❌ Missing: $cmd. Install: sudo apt install $cmd"; exit 1
    fi
done

# Resolve input/output
if (( ${#direct_files[@]} > 0 )); then
    mode="files"
    [ -z "$output_dir" ] && output_dir="./compressed"
else
    mode="dir"
    [ -z "$input_dir" ] && input_dir="."
    [ ! -d "$input_dir" ] && echo "❌ Directory '$input_dir' not found." && exit 1
    [ -z "$output_dir" ] && output_dir="$input_dir/$COMPRESSED_SUBDIR"
fi
mkdir -p "$output_dir"

# ── Helper: is file supported? (used only in file mode) ─────────────────────
is_supported() {
    local ext="${1##*.}"; ext="${ext,,}"
    for s in $SUPPORTED_EXTS; do [ "$ext" = "$s" ] && return 0; done
    return 1
}

# ── Encode functions ──────────────────────────────────────────────────────────
encode_vaapi() {
    local input="$1" output="$2"
    ffmpeg -hide_banner -loglevel error -stats \
        -vaapi_device /dev/dri/renderD128 -i "$input" \
        -vf "format=nv12,hwupload" \
        -c:v h264_vaapi -global_quality "$quality" \
        -c:a aac -b:a 96k "$output" -y
}

encode_cpu() {
    local input="$1" output="$2"
    ffmpeg -hide_banner -loglevel error -stats \
        -i "$input" \
        -c:v libx264 -crf "$quality" -pix_fmt yuv420p \
        -c:a aac -b:a 96k "$output" -y
}

# ── Process a single file ────────────────────────────────────────────────────
process_video() {
    local f="$1"
    local base; base=$(basename "$f")
    local name="${base%.*}"
    local out="$output_dir/${name}.mp4"

    # Skip if already in output dir
    if [[ "$(realpath "$f" 2>/dev/null)" == "$(realpath "$output_dir" 2>/dev/null)"/* ]]; then
        echo "⏭ SKIP  │ $base (already in output)"
        ((skipped++)) || true
        return
    fi
    if [ -f "$out" ]; then
        echo "⏭ SKIP  │ $base (output exists)"
        ((skipped++)) || true
        return
    fi

    echo "🎬 VIDEO │ $base"
    local success=0
    local used=""

    # Try VAAPI first
    if encode_vaapi "$f" "$out"; then
        success=1
        used="VAAPI"
    else
        echo "   ⚠️  VAAPI failed – falling back to CPU"
        rm -f "$out"  # remove partial output
        if encode_cpu "$f" "$out"; then
            success=1
            used="CPU"
        fi
    fi

    if [ $success -eq 1 ]; then
        # Sync OS-level modification/access dates from original file
        [ $preserve_times -eq 1 ] && touch -r "$f" "$out"

        orig_size=$(du -h "$f" | cut -f1)
        new_size=$(du -h "$out" | cut -f1)
        echo "        ✅ [${used}] ${orig_size} → ${new_size}"
        ((ok++)) || true
    else
        echo "        ❌ Conversion failed"
        ((fail++)) || true
    fi
}

# ── Main ──────────────────────────────────────────────────────────────────────
time_label=$([ $preserve_times -eq 1 ] && echo "on" || echo "off")
echo "📂 Output: $output_dir"
echo "⚙️  Quality: $quality | timesync: $time_label"
echo "──────────────────────────────────────────"

ok=0; fail=0; skipped=0

if [ "$mode" = "files" ]; then
    for f in "${direct_files[@]}"; do
        [ ! -f "$f" ] && echo "❌ File not found: $f" && continue
        is_supported "$f" || { echo "⚠️  SKIP │ $(basename "$f") (unsupported)"; ((skipped++)) || true; continue; }
        process_video "$f"
    done
else
    # Directory mode: collect all supported files (case‑insensitive)
    file_list=()
    while IFS= read -r -d '' f; do
        file_list+=("$f")
    done < <(find "$input_dir" -maxdepth 1 -type f \( -iname "*.mov" -o -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.avi" -o -iname "*.webm" \) -print0 2>/dev/null)

    echo "🔍 Found ${#file_list[@]} video file(s) in '$input_dir':"
    for f in "${file_list[@]}"; do
        echo "   - $(basename "$f")"
    done
    echo "──────────────────────────────────────────"

    if (( ${#file_list[@]} == 0 )); then
        echo "❌ No supported video files found."
        exit 1
    fi

    for f in "${file_list[@]}"; do
        process_video "$f"
    done
fi

echo "──────────────────────────────────────────"
echo "✅ Done. ${ok} ok, ${fail} failed, ${skipped} skipped."
(( fail > 0 )) && exit 1 || exit 0
